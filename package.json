{
  "name": "distributed-communication-platform",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "npm run test:middleware",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:middleware": "npm run test:unit && npm run test:integration",
    "test:unit:watch": "jest --config jest.unit.config.js --watch",
    "test:integration:watch": "jest --config jest.integration.config.js --watch",
    "mcp:android-test-environment": "node tools/android-test-environment-mcp/src/server.cjs",
    "security:prepare": "powershell -ExecutionPolicy Bypass -File docker/prepare-security.ps1"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.85.3",
    "crypto": "^1.0.1",
    "mqtt": "^5.15.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@testcontainers/mosquitto": "^12.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.4.1",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "^19.2.3",
    "typescript": "^5.8.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
